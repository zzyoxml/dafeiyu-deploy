# ═══════════════════════════════════════════════════════════
# robot.env 模板（脱敏版）
#
# 本文件由 robot.env 自动生成，所有密钥值已替换为占位符。
# 复制成 robot.env 后逐项填值：
#   cp robot.env.example robot.env && chmod 600 robot.env
#
# 注意：robot.env 已被 .gitignore 排除，真实密钥不要提交。
# ═══════════════════════════════════════════════════════════

# 大肥鱼 QQ 机器人 · 运行配置（本地部署用）
#
# setup.sh 会把本文件复制成 robot.env（权限 600，里面有密钥，勿提交/勿外传）。
# 格式：KEY=VALUE，一行一个，等号两边不加空格，值不加引号。
# 改完必须重建 AstrBot 容器：docker compose up -d --force-recreate astrbot
#
# ⚠️ 注意：`docker restart` 不会重新读 env_file，必须 --force-recreate。

# ============================================================
# ★ 必填
# ============================================================
DSH_ACL_OWNER=<主人QQ>

# ============================================================
# ★★ 关键：所有插件的作用群
#
# 这 43 个变量默认值全是占位群号 100000001，不是你的真实群号。
# 不填的后果：那些插件会一直「默默统计但从不执行」——
# 具体表现就是「机器人不主动说话、不接话、没情绪、不记人」。
#
# 本机真实群：<群号A>（AI之家_md3music）、<群号B>
# 多个群用英文逗号分隔，例如：<群号A>,<群号B>
# ============================================================
DSH_AGENCY_GROUPS=<群号A>,<群号B>,<群号C>
DSH_AIFLAVOUR_GROUPS=<群号A>,<群号B>,<群号C>
DSH_ARMOR_GROUPS=<群号A>,<群号B>,<群号C>
DSH_AWARENESS_GROUPS=<群号A>,<群号B>,<群号C>
DSH_CLARIFY_GROUPS=<群号A>,<群号B>,<群号C>
DSH_DESIRE_GROUPS=<群号A>,<群号B>,<群号C>
DSH_DRIFT_GROUPS=<群号A>,<群号B>,<群号C>
DSH_EFFECT_GROUPS=<群号A>,<群号B>,<群号C>
DSH_EXPRESS_GROUPS=<群号A>,<群号B>,<群号C>
DSH_FACTGUARD_GROUPS=<群号A>,<群号B>,<群号C>
DSH_FATIGUE_GROUPS=<群号A>,<群号B>,<群号C>
DSH_FOLLOWUP_GROUPS=<群号A>,<群号B>,<群号C>
DSH_GLOSSARY_GROUPS=<群号A>,<群号B>,<群号C>
DSH_GUARD_GROUPS=<群号A>,<群号B>,<群号C>
DSH_HOMOPHONE_GROUPS=<群号A>,<群号B>,<群号C>
DSH_HUMANIZER_GROUPS=<群号A>,<群号B>,<群号C>
DSH_IMG_CONCEPT_GROUPS=<群号A>,<群号B>,<群号C>
DSH_INITIATE_GROUPS=<群号A>,<群号B>,<群号C>
DSH_INTEREST_GROUPS=<群号A>,<群号B>,<群号C>
DSH_JOINGUARD_GROUPS=<群号A>,<群号B>,<群号C>
DSH_LEAKGUARD_GROUPS=<群号A>,<群号B>,<群号C>
DSH_MEM_PROFILE_GROUPS=<群号A>,<群号B>,<群号C>
DSH_MERGE_GROUPS=<群号A>,<群号B>,<群号C>
DSH_MIND_GROUPS=<群号A>,<群号B>,<群号C>
DSH_NOISE_GROUPS=<群号A>,<群号B>,<群号C>
DSH_PAY_GROUPS=<群号A>,<群号B>,<群号C>
DSH_PERSONA_CORE_GROUPS=<群号A>,<群号B>,<群号C>
DSH_POKE_GROUPS=<群号A>,<群号B>,<群号C>
DSH_PROACTIVE_GROUPS=<群号A>,<群号B>,<群号C>
DSH_QUOTEREF_GROUPS=<群号A>,<群号B>,<群号C>
DSH_REPEAT_GROUPS=<群号A>,<群号B>,<群号C>
DSH_SCENE_GROUPS=<群号A>,<群号B>,<群号C>
DSH_SELFAWARE_GROUPS=<群号A>,<群号B>,<群号C>
DSH_SELFGUARD_GROUPS=<群号A>,<群号B>,<群号C>
DSH_SELFWORTH_GROUPS=<群号A>,<群号B>,<群号C>
DSH_SLANG_GROUPS=<群号A>,<群号B>,<群号C>
DSH_SOCIAL_GROUPS=<群号A>,<群号B>,<群号C>
DSH_STEAL_GROUPS=<群号A>,<群号B>,<群号C>
DSH_TYPO_GROUPS=<群号A>,<群号B>,<群号C>
DSH_VID_CONCEPT_GROUPS=<群号A>,<群号B>,<群号C>
DSH_VOICE_EMOTION_GROUPS=<群号A>,<群号B>,<群号C>
DSH_WELCOME_GROUPS=<群号A>,<群号B>,<群号C>
DSH_WILL_GROUPS=<群号A>,<群号B>,<群号C>

# ============================================================
# ★★ 关键：关掉影子模式
#
# 这 16 个开关默认是 1（影子=只统计不执行）。
# 不关的后果：功能全部空转，机器人只会被动回话，不会主动。
# ============================================================
DSH_CLARIFY_SHADOW=0
DSH_DECIDE_SHADOW=0
DSH_EMOTION_SHADOW=0
DSH_FOLLOWUP_SHADOW=0
DSH_GUARD_SHADOW=0
DSH_HOMOPHONE_SHADOW=0
DSH_INITIATE_SHADOW=0
DSH_INTEREST_SHADOW=0
DSH_LEAKGUARD_RULE_SHADOW=0
DSH_MERGE_SHADOW=0
DSH_PERSONA_CORE_SHADOW=0
DSH_PROACTIVE_SHADOW=0
DSH_SELFGUARD_SHADOW=0
DSH_SLANG_SHADOW=0
DSH_SPINE_SHADOW=0
DSH_WILL_SHADOW=0

# ============================================================
# 说话频率
# ============================================================
DSH_DECIDE=1
DSH_DECIDE_MIN_GAP=15
DSH_DECIDE_COOLDOWN=600        # 同一话题 10 分钟内不重复接话
DSH_DECIDE_DIVE=1              # 允许潜水，多数消息不回复，更像真人
# 关掉「别的 AI 被喊时闭嘴」：群里有多台机器人，喊别人时也允许它插话
DSH_DECIDE_OTHER_AI=0
# 关掉「8 秒内全闭嘴」硬地板（设 0 = 不检查）
DSH_DECIDE_GAP_HARD=0

# 主动探头（兴趣接话）：阈值越低越爱说话
DSH_PROACTIVE=1
DSH_PROACTIVE_THRESHOLD=6      # 默认 8，降低一点让它更容易接
DSH_PROACTIVE_MIN_INTERVAL_MS=120000   # 默认 180000，缩到 2 分钟
DSH_PROACTIVE_DAY_MAX=15       # 默认 12，每天最多主动 15 次
DSH_PROACTIVE_HOURS=9-23,0-1   # 活跃时段

# 冷场后主动开口
DSH_INITIATE=1

# 免艾特续聊概率
DSH_FOLLOWUP=1

# 社交关系注入（shadow=只记分｜style=注入口吻｜live=留给 decide 读）
DSH_SOCIAL=1
DSH_SOCIAL_MODE=style

# 自主意志：允许偶尔不想说话
DSH_WILL=1
DSH_WILL_SILENCE_PER_DAY=2
DSH_WILL_QUIET_MIN=12

# 心智观察
DSH_MIND=1
DSH_MIND_MODE=observe

# ============================================================
# 说话风格
# ============================================================
DSH_HUMAN=1
DSH_HUMAN_SPLIT_RATE=0.7       # 长回复拆多条发的概率
DSH_TYPO_RATE=0.04             # 打错同音字概率（0.06 有点高，降一点）
DSH_NOISE=1                    # 口语噪点

# ============================================================
# 自主意志（只影响立场，不降低事实与工具任务质量）
# ============================================================
DSH_AGENCY=1
DSH_AGENCY_MODE=live           # shadow=只记分｜style=只表达立场｜live=完整
DSH_AGENCY_OWNER=<主人QQ>
DSH_AGENCY_REPEAT_WINDOW=300
DSH_AGENCY_INJECT_BUDGET=620

# 人格驱动核心
DSH_PERSONA_CORE=1
DSH_PERSONA_CORE_MIN_WAKE=0.58 # 唤醒分数门槛，越低越容易主动

# ============================================================
# 上下文与记忆
# ============================================================
DSH_CTX_KEEP_TURNS=30
DSH_MEM_DECAY=1

# ============================================================
# 联网与出口审核
# ============================================================
DSH_WEB_ENABLE=1
DSH_WEB_MOD=1
DSH_WEB_MOD_TIMEOUT=12
DSH_WEB_SEARCH_KEY=

# ============================================================
# 权限与安全
# ============================================================
DSH_ACL=1
DSH_ACL_QUIET=0
DSH_SCENE_TZ=Asia/Shanghai

# ============================================================
# 可选：多模态（缺哪个就少哪个功能，不影响其他）
# ============================================================
DSH_VIS_CHAIN=
DSH_IMAGEGEN_KEY=
DSH_VOICE_ID=

# ---- 不 @ 也能说话（dsh-awake 自建插件）----
# 框架默认只有被 @ / 被回复 / 以 / 开头的群消息才调 LLM。
# 打开这个让普通闲聊也进 LLM，再由 dsh-decide 决定说不说。
DSH_AWAKE=1
DSH_AWAKE_GROUPS=<群号A>,<群号B>,<群号C>

# Anysearch 搜索（无需密钥即可匿名使用，有 key 额度更稳）
# 申请地址 https://anysearch.com/console/api-keys
DSH_WEB_ANYSEARCH_KEY=

# ---- 禁言开关（dsh-mute）----
# 任何人说「闭嘴」→ 禁言 1 小时；只有主人能解除
DSH_MUTE_OWNER=<主人QQ>
DSH_MUTE_HOURS=1
DSH_DECIDE_DIVE_RATE_REPLY=0
DSH_DECIDE_DIVE_RATE_ABOUT=0
DSH_DECIDE_DIVE_RATE_OPEN=0.05
DSH_DECIDE_DIVE_RATE_BANTER=0.15
DSH_DECIDE_DIVE_RATE_NONE=0.45
DSH_SLEEP=0
DSH_FATIGUE=0
DSH_STEAL=1
DSH_STEAL_MIN_COUNT=1
DSH_STEAL_MAX_STORED=300
DSH_STEAL_AUTO_RATE=0.6
DSH_STEAL_AUTO_COOLDOWN=90
DSH_STEAL_AUTO_MAX_CHARS=60
DSH_STEAL_AUTO_CANDIDATES=15
DSH_IMG_BACKEND=openai
DSH_IMG_MODEL=cogview-3-flash
DSH_IMG_SIZE=1024x1024
DSH_IMG_POLL_MODEL=sdxl
DSH_IMG_POLL_NOLOGO=1
DSH_IMG_TIMEOUT=150
DSH_IMG_COOLDOWN=50
DSH_IMG_STYLE=cute chibi anime style, kawaii, flat colors, simple background
DSH_IMG_TR_PROVIDER=
DSH_IMG_TR_TOKENS=300
DSH_IMG_API_BASE=https://open.bigmodel.cn/api/paas/v4
DSH_IMG_API_KEY=<在此填入你的值>
DSH_IMG_FALLBACK=glm-image

# --- Edge TTS (Microsoft 免费女声) ---
DSH_VOICE_BACKEND=edge
DSH_VOICE_EDGE_VOICE=zh-CN-XiaoxiaoNeural
DSH_VOICE_EDGE_FALLBACK=1
DSH_VOICE_FORMAT=wav
DSH_VOICE_MAX_CHARS=150
DSH_VOICE_TIMEOUT=60
DSH_VOICE_COOLDOWN=15
DSH_QZONE_ENABLED=1
DSH_QZONE_MINUTE=0
DSH_QZONE_OWNER=<主人QQ>

# ---- dsh-sing 唱歌技能 ----
# owner=仅主人 / original=群友原唱 / ai=群友原唱+AI翻唱
# 群友片段上限（CPU 上 30s 约 2-3 分钟；主人不受此限）
# 个人冷却（秒）
# 本群冷却（秒）
# 排队最长等待（秒）

# ===== 唱歌技能（2026-10-30）=====
# 成品缓存：同一首歌再点直接复用，不重跑 demucs/RVC。LRU 上限 100 首。
DSH_SING_CACHE_MAX=100
# 群友权限：owner / original / ai。ai = 群友可用 /原唱 + /唱歌
DSH_SING_GROUP_ACCESS=ai
# 群友单次片段上限（秒）与冷却
DSH_SING_MAX_SECONDS_GROUP=30
DSH_SING_COOLDOWN_USER=120
DSH_SING_COOLDOWN_GROUP=30
DSH_SING_QUEUE_WAIT=180
# 主人 QQ
DSH_SING_OWNER=<在此填入你的值>
DSH_SELF_ID=<在此填入你的值>

# ===== 语音流萤音色（2026-10-30）=====
# 普通回复按概率自动用流萤音色出声
DSH_VOICE_LY_RATE=0.20
# 只念 4~40 字：太短没意思，太长变声慢且群里没人愿意听
DSH_VOICE_LY_MAX_CHARS=40
# 全局冷却与小时配额，避免连发
DSH_VOICE_LY_COOLDOWN=45
DSH_VOICE_LY_HOURLY=8
# 单次变声超时（CPU 4 核，40 字约 40~60s）
DSH_VOICE_LY_TIMEOUT=300
# Edge 底音 + 参数（再过 RVC 变流萤）
DSH_VOICE_LY_EDGE_VOICE=zh-CN-XiaoxiaoNeural
DSH_VOICE_LY_EDGE_RATE=-5%
DSH_VOICE_LY_EDGE_PITCH=+2Hz

# ===== 回复节流（2026-10-30）=====
# 普通文字一分钟最多 10 条（滑动窗口）
DSH_GUARD_RATE_WINDOW=60
DSH_GUARD_RATE_MAX=10
# 主人豁免限流（但陈旧拦截不豁免）
DSH_GUARD_OWNER_BYPASS=1
# 群里积压超过 10 句且未点名/@ 时不接话
DSH_GUARD_STALE=1
DSH_GUARD_STALE_LAG=10
